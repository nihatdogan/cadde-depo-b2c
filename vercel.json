{
  "functions": {
    "api/urun.js": { "includeFiles": "urun.html" },
    "api/home.js": { "includeFiles": "index.html" }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/iade-politikasi", "destination": "/iade-politikasi.html" },
    { "source": "/mesafeli-satis-sozlesmesi", "destination": "/mesafeli-satis-sozlesmesi.html" },
    { "source": "/on-bilgilendirme", "destination": "/on-bilgilendirme.html" },
    { "source": "/kvkk", "destination": "/kvkk.html" },
    { "source": "/gizlilik", "destination": "/gizlilik.html" },
    { "source": "/iletisim", "destination": "/iletisim.html" },
    { "source": "/firsat-kulubu", "destination": "/firsat-kulubu.html" },
    { "source": "/firsat-kulubu-aydinlatma", "destination": "/firsat-kulubu-aydinlatma.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/urun/:slug", "destination": "/api/urun?slug=:slug" }
  ]
}
