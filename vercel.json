{
  "functions": {
    "api/urun.js": { "includeFiles": "urun.html" },
    "api/home.js": { "includeFiles": "index.html" }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/urun/:slug", "destination": "/api/urun?slug=:slug" }
  ]
}
